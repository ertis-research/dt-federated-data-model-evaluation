# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=password

# Dgraph Configuration (gRPC)
DGRAPH_URI=localhost:32211

# TimescaleDB / PostgreSQL Multi-ISU Configuration (Consecutive NodePorts: 45521..45528)
TS_HOST=localhost
TS_BASE_PORT=45521
TS_NUM_ISUS=8
# Optional: explicitly override ports as comma-separated list
# TS_PORTS=45521,45522,45523,45524,45525,45526,45527,45528
TS_NAME=postgres
TS_USER=postgres
TS_PASS=postgres

PROMETHEUS_URL=http://localhost:9090
KUBERNETES_NAMESPACE=default